# Normalise to LF in the repository. Without this, a checkout on Windows
# commits CRLF and the shell steps in the workflows and the Dockerfile break
# when the same files are used on Linux.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.zip binary
*.woff binary
*.woff2 binary
