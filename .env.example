# Every one of these is optional. Set them in compose.yaml instead if you
# prefer to keep everything in one file.

# Port inside the container.
PORT=8787

# Where the database and uploads live. The image sets this to /data.
DATA_DIR=/data

# Set both to 1 when Drydock is served over HTTPS, through a reverse proxy or
# a Cloudflare Tunnel. Without them the session cookie will not stick.
TRUST_PROXY=0
SECURE_COOKIE=0

# How long a sign-in lasts, in days.
SESSION_DAYS=30

# Uploads are re-encoded to WebP: longest side in pixels, quality 1-100, and
# the ceiling for a single file.
IMAGE_MAX_EDGE=2200
IMAGE_QUALITY=78
MAX_UPLOAD_MB=40

# The ceiling for an imported .drydock.zip.
MAX_IMPORT_MB=512

# Update checking. Reads the public GitHub releases list every six hours and
# shows a notice in the web app when a newer version exists. Nothing is sent.
UPDATE_CHECK=1
UPDATE_REPO=ThomasYates/drydock
UPDATE_CHECK_HOURS=6

TZ=Europe/London
